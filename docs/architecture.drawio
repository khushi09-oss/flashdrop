<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="FlashDrop | Production architecture" id="architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="FlashDrop | Production architecture&#10;Accept safely in one database transaction. Process asynchronously with safe retries." style="text;html=0;fontSize=24;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1500" height="80" />
        </mxCell>
        <mxCell id="cloud" value="PROPOSED AWS PRODUCTION ENVIRONMENT" style="rounded=1;dashed=1;fillColor=#eef2ff;strokeColor=#a5b4fc;verticalAlign=top;align=left;spacing=20;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="120" width="1320" height="640" />
        </mxCell>
        <mxCell id="e0" value="HTTPS" edge="1" parent="1" source="client" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e1" value="Route" edge="1" parent="1" source="gateway" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Optional" edge="1" parent="1" source="api" target="redis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="1. Reserve" edge="1" parent="1" source="api" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="2. Durable event" edge="1" parent="1" source="db" target="relay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="3. Publish" edge="1" parent="1" source="relay" target="kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="4. Consume" edge="1" parent="1" source="kafka" target="worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="5. Confirm" edge="1" parent="1" source="worker" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;fontSize=14;labelBackgroundColor=#f8fafc;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="client" value="Customers&#10;Stable retry key" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#475569;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="310" width="150" height="100" />
        </mxCell>
        <mxCell id="gateway" value="Gateway + ALB&#10;JWT authentication&#10;Rate limiting&#10;Load balancing" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#4f46e5;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="270" y="290" width="205" height="140" />
        </mxCell>
        <mxCell id="api" value="API instances x N&#10;Docker / ECS Fargate&#10;Stateless" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#4f46e5;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="300" width="225" height="120" />
        </mxCell>
        <mxCell id="redis" value="Redis / ElastiCache&#10;Metadata cache only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d97706;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="175" width="225" height="85" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL / RDS&#10;INVENTORY AUTHORITY&#10;Stock + orders + outbox&#10;One atomic transaction" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#059669;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="890" y="285" width="260" height="150" />
        </mxCell>
        <mxCell id="relay" value="Outbox relay x N&#10;Read committed events&#10;Publish, then mark sent" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#4f46e5;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="890" y="590" width="260" height="110" />
        </mxCell>
        <mxCell id="kafka" value="Kafka / Amazon MSK&#10;Replicated event log&#10;At-least-once delivery" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#7c3aed;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1250" y="590" width="260" height="110" />
        </mxCell>
        <mxCell id="worker" value="Order workers x N&#10;Docker / ECS Fargate&#10;PENDING to CONFIRMED&#10;Commit DB, then ACK" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#4f46e5;fontSize=17;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1250" y="285" width="260" height="150" />
        </mxCell>
        <mxCell id="note0" value="Redis outages do not change accepted orders. PostgreSQL is authoritative for inventory and retry keys." style="text;html=0;align=left;fontSize=17;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="780" width="1500" height="30" />
        </mxCell>
        <mxCell id="note1" value="Outbox closes the DB-to-broker crash gap. Duplicate events are safe because confirmation is conditional." style="text;html=0;align=left;fontSize=17;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="810" width="1500" height="30" />
        </mxCell>
        <mxCell id="note2" value="Local runnable version: SQLite + durable jobs table. Cloud components shown here are the production design." style="text;html=0;align=left;fontSize=17;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="840" width="1500" height="30" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
